# Server
PORT=3000

# Turso (https://turso.tech) — libSQL over HTTP
# Remote: libsql://your-db-name-org.turso.io
# Local dev without Turso: file:smart_events.db (leave token empty)
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# iCloud CalDAV (app-specific password from appleid.apple.com)
ICLOUD_USERNAME=your-apple-id@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Site login (your main Apple ID password)
AUTH_USERNAME=your-apple-id@icloud.com
AUTH_PASSWORD=your-apple-id-password
SESSION_SECRET=generate-a-long-random-string-here

# Output calendar in Apple Calendar (must exist or app will try to create it)
SMART_CALENDAR_NAME=Smart Events

# Scheduling defaults
WORKING_HOURS_START=08:00
WORKING_HOURS_END=21:00
SCHEDULE_DAYS_AHEAD=7
MIN_GAP_MINUTES=15
TIMEZONE=America/Los_Angeles
