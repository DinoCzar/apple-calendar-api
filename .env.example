# Server
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/smart_events

# iCloud CalDAV (generate app-specific password at https://appleid.apple.com)
ICLOUD_USERNAME=your-apple-id@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Calendar names (must match your Apple Calendar app)
APPLE_CALENDAR_NAME=apple events
SMART_CALENDAR_NAME=Smart Events

# Scheduling defaults
WORKING_HOURS_START=08:00
WORKING_HOURS_END=21:00
SCHEDULE_DAYS_AHEAD=7
MIN_GAP_MINUTES=15
TIMEZONE=America/Los_Angeles
